{
  "name": "bilibili-home-v0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0 --port 3302 --strictPort",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3302 --strictPort",
    "test": "vitest run",
    "check:api": "node tests/api.mjs",
    "check:browser": "node scripts/browser-input.mjs | ego-browser nodejs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  }
}
