{
  "name": "bilibili-clone-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "bilibili 首页复刻 —— 后端 (Express + TypeScript + SQLite 分层架构)",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "start": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start:prod": "NODE_NO_WARNINGS=1 node dist/index.js",
    "db:ensure": "NODE_NO_WARNINGS=1 tsx src/db/ensure.ts",
    "seed": "node scripts/probe-durations.mjs && NODE_NO_WARNINGS=1 tsx src/db/seed.ts",
    "probe-durations": "node scripts/probe-durations.mjs",
    "fetch-data": "node scripts/fetch-data.mjs",
    "fetch-banners": "node scripts/fetch-banners.mjs",
    "normalize-media": "node scripts/normalize-media.mjs",
    "test": "NODE_NO_WARNINGS=1 node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
